---
import Shell from '../layouts/Shell.astro';
import { getModel } from '../lib/model';
import { homeGraph, carburanteApp } from '../lib/jsonld';

const model = await getModel();
---
<Shell
  model={model}
  page="index"
  startId="index"
  seo={{
    title: 'Wagner Rosa — Product Designer',
    description: 'Wagner Rosa is a Product Designer, currently UX Lead at Nelogica, working on complex financial products, design systems, AI and prototyping in code.',
    ogDescription: 'Product Designer, currently UX Lead at Nelogica. Complex financial products, design systems, AI and prototyping in code.',
    path: '/',
  }}
  jsonld={[homeGraph(), carburanteApp()]}
/>
