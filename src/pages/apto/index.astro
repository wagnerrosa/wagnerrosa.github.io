---
// Private-ish listing page: shared by link only. Not in sitemap.xml / llms.txt, noindex, no site shell (Google Analytics is added on its own).
// Photos are read from public/apto/ at build time (see scripts/apto-photos.mjs), so adding a photo needs no code change.
import '@fontsource-variable/figtree';
import '@fontsource-variable/source-serif-4';
import '../../styles/tokens.css';
import '../../styles/apto.css';
import { readFileSync, existsSync } from 'node:fs';
import ThemeScript from '../../components/ThemeScript.astro';
import Analytics from '../../components/Analytics.astro';
import { abs } from '../../data/site';
import { apto } from '../../data/apto';
import { shots, tour as tourStems } from '../../data/apto-plan';
import { cone } from '../../lib/plan-svg';
import Plan from '../../components/apto/Plan.astro';

type Photo = { file: string; video?: string; caption: string; group: string; groupLabel: string; w: number; h: number };
const manifest: Photo[] = existsSync('public/apto/photos.json') ? JSON.parse(readFileSync('public/apto/photos.json', 'utf8')) : [];
const shotOf = (p: Photo) => shots[p.file.replace(/\.webp$/, '')];
const photos = manifest.map((p, i) => {
  const s = shotOf(p);
  return {
    full: `/apto/${p.file}`,
    thumb: `/apto/thumb/${p.file}`,
    video: p.video ? `/apto/${p.video}` : '',
    alt: `${p.caption} (foto ${i + 1} de ${manifest.length})`,
    caption: p.caption,
    group: p.group,
    first: i === 0 || manifest[i - 1].group !== p.group,   // first photo of a room: carries the jump anchor
    ar: +(p.w / p.h).toFixed(4),
    shot: s ? { x: s[0], y: s[1], a: s[2] } : null,   // where it was taken and which way the camera points, for the viewer's mini map
  };
});
const groups = manifest.reduce<{ id: string; label: string; n: number }[]>((acc, p) => {
  const g = acc.find(x => x.id === p.group);
  g ? g.n++ : acc.push({ id: p.group, label: p.groupLabel, n: 1 });
  return acc;
}, []);
const counts = Object.fromEntries(groups.map(g => [g.id, g.n]));
const planShots = manifest.flatMap((p, i) => { const s = shotOf(p); return s ? [{ i, g: p.group, x: s[0], y: s[1], a: s[2] }] : []; });
// the demo tour's photos, as indexes into photos (a stem with no photo or no spot on the plan is dropped)
const tour = tourStems.map(t => manifest.findIndex(p => p.file === `${t}.webp`)).filter(i => i >= 0 && !!shotOf(manifest[i]));
// The viewer's camera: cone drawn at the origin pointing right, placed by a CSS transform (translate + rotate) so it glides between photos.
// .lb-ring is the pulse of the one-time hint on phones.
const lbCamera = `<g id="lb-pos" class="lb-pos"><path class="lb-cone" d="${cone(0, 0, 0)}"/><circle class="lb-ring" r="13"/><circle class="lb-cam" r="13"/></g>`;
const hasOg = existsSync('public/apto/og.jpg');
const brl = (n: number) => n.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{apto.title}</title>
    <meta name="description" content={apto.summary} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <meta property="og:title" content={apto.title} />
    <meta property="og:description" content={apto.summary} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={abs('/apto/')} />
    {hasOg && <meta property="og:image" content={abs('/apto/og.jpg')} />}
    {hasOg && <meta property="og:image:width" content="1200" />}
    {hasOg && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={hasOg ? 'summary_large_image' : 'summary'} />
    <ThemeScript js={false} />
    <Analytics />
  </head>
  <body>
    <button type="button" id="theme" class="theme" aria-label="Alternar tema claro/escuro" title="Alternar tema claro/escuro">
      <svg class="i-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      <svg class="i-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
    <div class="page">
      <div class="info">
        <header class="top">
          <p class="mono">À venda · {apto.neighborhood}, Porto Alegre</p>
          <h1>{apto.headline}</h1>
          <p class="lede">{apto.summary}</p>
          <dl class="facts">
            {apto.facts.map(([k, v]) => <div><dt class="mono">{k}</dt><dd>{v}</dd></div>)}
            {apto.price > 0 && <div class="price"><dt class="mono">Valor</dt><dd>{brl(apto.price)}</dd></div>}
          </dl>
        </header>

        <main class="text">
          {apto.sections.map(s => (
            <section>
              <h2 class="mono">{s.title}</h2>
              {s.intro && <p class="prose">{s.intro}</p>}
              {s.items && <ul class="bullets">{s.items.map(t => <li>{t}</li>)}</ul>}
              {s.outro && <p class="prose">{s.outro}</p>}
            </section>
          ))}
          <p class="closing prose">{apto.closing}</p>
          <section class="map">
            <h2 class="mono">Mapa</h2>
            <iframe title={`Mapa: ${apto.address}`} src={`https://maps.google.com/maps?q=${encodeURIComponent(apto.address)}&z=16&output=embed`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
            <p class="prose"><a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(apto.address)}`} target="_blank" rel="noopener">Abrir no Google Maps ↗</a></p>
          </section>
        </main>
      </div>

      {photos.length > 0 && (
        <div class="gallery">
        <section class="plan-sec" id="planta" aria-labelledby="plan-h">
          <h2 class="mono" id="plan-h">Planta</h2>
          <Plan o="land" counts={counts} shots={planShots} />
          <Plan o="port" counts={counts} />
          <div class="plan-foot">
            <ul class="plan-key" aria-label="Legenda">
              <li><i class="k-wood"></i>Parquet</li>
              <li><i class="k-tile"></i>Piso</li>
              <li><i class="k-win"></i>Janela</li>
            </ul>
            <p class="plan-hint"><span class="h-hover">Clique num ambiente para ver as fotos; passe o mouse para ver de onde cada uma foi tirada.</span><span class="h-touch">Toque num ambiente para ver as fotos e, no mapa, de onde cada uma foi tirada.</span> <span class="h-meta">Planta ilustrativa, sem escala. <a href="/apto/planta.png" download="planta-apartamento.png">Baixar planta ↓</a></span></p>
          </div>
        </section>
        <section class="photos" aria-label="Fotos">
          <nav class="chips" id="chips" aria-label="Ir para o ambiente">
            <a href="#planta" class="chip-plan" data-plan><svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M1.5 1.5h13v13h-13zM1.5 8h5M9.5 1.5v6.5h5M6.5 8v6.5"/></svg>Planta</a>
            {groups.map(g => <a href={`#${g.id}`} data-g={g.id}>{g.label}<span>{g.n}</span></a>)}
          </nav>
          <ul class="grid" id="grid">
            {photos.map((p, i) => (
              <>
                {p.first && <li class="gh" id={p.group}><h2 class="mono">{groups.find(g => g.id === p.group)!.label}</h2></li>}
                <li class={p.ar > 1 ? 'land' : ''} style={`--ar:${p.ar};--bg:url(${p.thumb})`} data-g={p.group} data-first={p.first ? '' : undefined}>
                  <button type="button" data-i={i} aria-label={`${p.video ? 'Assistir' : 'Ampliar'}: ${p.caption}`}>
                    <img src={p.thumb} srcset={`${p.thumb} 720w, ${p.full} 1800w`} sizes="(min-width: 900px) 40vw, 92vw" alt={p.alt} loading={i < 3 ? 'eager' : 'lazy'} decoding="async" />
                    {p.video && <video class="clip" muted loop playsinline preload="none" data-src={p.video} aria-hidden="true" tabindex="-1"></video>}
                    {p.video && <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>}
                    <span class="cap">{p.caption}</span>
                  </button>
                </li>
              </>
            ))}
          </ul>
        </section>
        </div>
      )}
    </div>

    <!-- Desktop: photo centered, caption/count/mini map float over it (.lb-stage, .lb-bar, .lb-meta are display: contents).
         Phone: photo on top, a bar underneath with the caption and the plan across the full width. -->
    <dialog id="lb" aria-label="Galeria de fotos">
      <div class="lb-stage" id="lb-stage">
        <img id="lb-img" alt="" />
        <video id="lb-vid" controls playsinline preload="metadata" hidden></video>
        <button type="button" class="lb-n lb-prev" id="lb-prev" aria-label="Foto anterior">‹</button>
        <button type="button" class="lb-n lb-next" id="lb-next" aria-label="Próxima foto">›</button>
      </div>
      <div class="lb-bar">
        <div class="lb-meta">
          <p class="lb-l" id="lb-label"></p>
          <p class="lb-c mono" id="lb-count"></p>
        </div>
        <div class="lb-map off" id="lb-map">
          <Plan o="land" mini shots={planShots} extra={lbCamera} />
          <p class="lb-off">Área comum, fora da planta do apartamento</p>
          <p class="lb-coach" id="lb-coach" hidden>Foto tirada daqui</p>
        </div>
      </div>
      <button type="button" class="lb-x" id="lb-close" aria-label="Fechar">×</button>
    </dialog>

    <script is:inline define:vars={{ photos, tour }}>
      var dlg = document.getElementById('lb'), img = document.getElementById('lb-img'), vid = document.getElementById('lb-vid'), count = document.getElementById('lb-count'), label = document.getElementById('lb-label'), cur = 0;
      function show(i, snap) {
        cur = (i + photos.length) % photos.length;
        vid.pause();
        var isVid = !!photos[cur].video;
        img.hidden = isVid; vid.hidden = !isVid;
        if (isVid) { vid.poster = photos[cur].full; vid.src = photos[cur].video; if (dlg.open) vid.play().catch(function () {}); }
        else { vid.removeAttribute('src'); vid.load(); img.src = photos[cur].full; img.alt = photos[cur].alt; }
        count.textContent = (cur + 1) + ' / ' + photos.length;
        label.textContent = photos[cur].caption;
        aim(photos[cur], snap);
        coach(photos[cur]);
        // warm the neighbours so next/prev feels instant
        [cur + 1, cur - 1].forEach(function (n) { new Image().src = photos[(n + photos.length) % photos.length].full; });
      }
      function openAt(i) { var fresh = !dlg.open; if (fresh) dlg.showModal(); show(i, fresh); }
      document.querySelectorAll('.grid button').forEach(function (b) {
        b.addEventListener('click', function () { openAt(+b.dataset.i); });
      });

      // Floor plan. A room opens the viewer at its first photo (without JS its link jumps to the room's photos).
      // In the viewer a mini map shows where the current photo was taken and which way the camera points.
      // The other photos of the same room show as dots, so swiping reads as walking around the room: the camera glides to the next spot
      // and turns the short way round. It appears in place (no glide) when the viewer opens or comes back from a photo off the plan.
      // Photos outside the flat (condomínio…): hidden on desktop, dimmed with a note on phones (the bar keeps its height).
      var map = document.getElementById('lb-map'), lpos = document.getElementById('lb-pos'), lcam = lpos.querySelector('.lb-cam'), lang = null, firstOf = {};
      var mroom = map.querySelectorAll('.room'), mdots = map.querySelectorAll('.shot');
      photos.forEach(function (p, i) { if (!(p.group in firstOf)) firstOf[p.group] = i; });
      function aim(p, snap) {
        map.classList.toggle('off', !p.shot);
        mroom.forEach(function (r) { r.classList.toggle('cur', r.dataset.g === p.group); });
        mdots.forEach(function (s) { s.classList.toggle('on', !!p.shot && s.dataset.g === p.group && +s.dataset.i !== cur); });
        if (!p.shot) { lang = null; return; }
        var a = p.shot.a;
        snap = snap || lang === null;
        if (snap) lpos.classList.add('snap');
        else a = lang + ((((a - lang) % 360) + 540) % 360) - 180;
        lang = a;
        lpos.style.transform = 'translate(' + p.shot.x + 'px,' + p.shot.y + 'px) rotate(' + a + 'deg)';
        if (snap) { lpos.getBoundingClientRect(); lpos.classList.remove('snap'); }
      }
      // Phones, once per page load: the first photo opened that has a spot on the plan points at the camera ("Foto tirada daqui") with a pulse.
      // The next photo, a tap on the map, closing the viewer or a few seconds take it away.
      var coachEl = document.getElementById('lb-coach'), narrow = matchMedia('(max-width: 899px)'), coachT = 0, coached = false;
      function uncoach() { clearTimeout(coachT); coachEl.hidden = true; map.classList.remove('coach'); }
      function coach(p) {
        uncoach();
        if (coached || !p.shot || !narrow.matches) return;
        coached = true;
        var c = lcam.getBoundingClientRect(), b = map.getBoundingClientRect();
        var x = c.left + c.width / 2 - b.left, y = c.top + c.height / 2 - b.top;
        coachEl.hidden = false;
        map.classList.add('coach');
        var half = coachEl.offsetWidth / 2, l = Math.min(Math.max(x, half + 4), b.width - half - 4);
        coachEl.classList.toggle('below', y < b.height / 2);   // upper half: the label hangs under the dot, clear of the caption
        coachEl.style.setProperty('--x', l + 'px');
        coachEl.style.setProperty('--y', y + 'px');
        coachEl.style.setProperty('--ax', Math.max(-half + 14, Math.min(half - 14, x - l)) + 'px');
        coachT = setTimeout(uncoach, 6000);
      }
      document.querySelectorAll('.plan .room').forEach(function (a) {
        a.addEventListener('click', function (e) {
          if (!(a.dataset.g in firstOf)) return;
          e.preventDefault();
          openAt(firstOf[a.dataset.g]);
        });
      });
      // Desktop plan: hovering a room shows its photo markers; hovering a marker previews the photo, clicking opens it.
      var land = document.querySelector('.plan-land'), tip = land && land.querySelector('.plan-tip');
      if (land && tip && matchMedia('(hover: hover)').matches) {
        var marks = land.querySelectorAll('.shot'), grp = '', wait = 0;
        // Switching rooms waits a beat, so the pointer can cross a neighbouring room to reach a marker that sits outside its own room.
        function setGroup(g) { grp = g; marks.forEach(function (s) { s.classList.toggle('on', s.dataset.g === g); }); }
        function peek(s) {   // the marker's photo, as a thumbnail above it (under it when the marker is too close to the top of the screen)
          var c = s.querySelector('.cam').getBoundingClientRect(), b = land.getBoundingClientRect(), below = c.top < 150;
          tip.src = photos[+s.dataset.i].thumb;
          tip.classList.toggle('below', below);
          tip.style.setProperty('--x', (c.left + c.width / 2 - b.left) + 'px');
          tip.style.setProperty('--y', ((below ? c.bottom : c.top) - b.top) + 'px');
          tip.hidden = false;
        }
        land.addEventListener('pointerover', function (e) {
          var t = e.target.closest('.room, .shot');
          if (!t) return;
          endDemo();
          toured = true;   // found it on their own: no tour later in this visit
          var isShot = t.classList.contains('shot');
          clearTimeout(wait);
          if (t.dataset.g === grp) { /* same group: keep */ }
          else if (isShot || !grp) setGroup(t.dataset.g);
          else wait = setTimeout(function () { setGroup(t.dataset.g); tip.hidden = true; }, 350);
          if (!isShot) { if (t.dataset.g === grp) tip.hidden = true; return; }
          peek(t);
        });
        land.addEventListener('pointerleave', function () { clearTimeout(wait); grp = ''; marks.forEach(function (s) { s.classList.remove('on'); }); tip.hidden = true; });
        marks.forEach(function (s) { s.addEventListener('click', function () { tip.hidden = true; openAt(+s.dataset.i); }); });

        // Demo tour (mini onboarding), once per page load: when the plan first comes into view it plays what a hover does, by itself,
        // stop after stop (`tour` in src/data/apto-plan.ts, ~3 s each): the photo's room lights up, its markers come in one by one,
        // the chosen photo shows as the thumbnail, then all fades and the next stop starts. One pass, then it stops (no endless loop
        // next to the text). A pointer over the plan, keyboard focus in it, or the plan leaving the screen ends it. Reduced motion: first stop only.
        var toured = false, demo = null;
        function clearRoom() {
          land.classList.remove('demo');
          if (demo && demo.room) demo.room.classList.remove('lit');
          if (demo && demo.hot) demo.hot.classList.remove('hot');
          tip.hidden = true;
          setGroup('');
        }
        function endDemo() {
          if (!demo) return;
          demo.timers.forEach(clearTimeout);
          clearRoom();
          demo = null;
        }
        function later(f, ms) { demo.timers.push(setTimeout(f, ms)); }
        function playRoom(i, done) {
          var hot = land.querySelector('.shot[data-i="' + i + '"]'), g = hot && hot.dataset.g;
          var room = g && land.querySelector('.room[data-g="' + g + '"]');
          if (!room) return done();
          var ms = [].filter.call(marks, function (s) { return s.dataset.g === g; });
          ms.forEach(function (s, k) { s.style.setProperty('--k', k); });
          demo.room = room; demo.hot = hot;
          land.classList.add('demo');
          room.classList.add('lit');
          setGroup(g);
          var t = ms.length * 90 + 500;
          later(function () { hot.classList.add('hot'); peek(hot); }, t);
          later(function () { clearRoom(); demo.room = demo.hot = null; later(done, 450); }, t + 1900);
        }
        function runDemo() {
          var stops = matchMedia('(prefers-reduced-motion: reduce)').matches ? tour.slice(0, 1) : tour, k = 0;
          stops.forEach(function (i) { new Image().src = photos[i].thumb; });
          demo = { room: null, hot: null, timers: [] };
          (function next() { if (k < stops.length) playRoom(stops[k++], next); else endDemo(); })();
        }
        land.addEventListener('focusin', function () { toured = true; endDemo(); });
        if ('IntersectionObserver' in window) {
          var dwait = 0;
          new IntersectionObserver(function (es) {
            clearTimeout(dwait);
            if (!es[es.length - 1].isIntersecting) return endDemo();
            if (!toured) dwait = setTimeout(function () { if (!toured) { toured = true; runDemo(); } }, 800);
          }, { threshold: 0.6 }).observe(land);
        }
      }
      dlg.addEventListener('close', function () { vid.pause(); uncoach(); });
      document.getElementById('lb-close').onclick = function () { dlg.close(); };
      document.getElementById('lb-prev').onclick = function () { show(cur - 1); };
      document.getElementById('lb-next').onclick = function () { show(cur + 1); };
      var stage = document.getElementById('lb-stage');
      dlg.addEventListener('click', function (e) { if (e.target === dlg || e.target === stage) dlg.close(); });
      dlg.addEventListener('keydown', function (e) {
        if (e.target === vid) return;   // arrows seek inside the video
        if (e.key === 'ArrowRight') show(cur + 1);
        if (e.key === 'ArrowLeft') show(cur - 1);
      });
      // Clips in the gallery play (muted, looped) while they are on screen and pause when they leave. Tapping opens the viewer with sound.
      var clips = document.querySelectorAll('.clip');
      if (clips.length && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        var cio = new IntersectionObserver(function (es) {
          es.forEach(function (en) {
            var v = en.target;
            if (en.isIntersecting) {
              if (!v.src) v.src = v.dataset.src;   // load only when first reached
              v.play().then(function () { v.classList.add('on'); v.parentElement.classList.add('playing'); }).catch(function () {});
            } else { v.pause(); }
          });
        }, { threshold: 0.6 });
        clips.forEach(function (v) { cio.observe(v); });
      }
      var tx;
      dlg.addEventListener('touchstart', function (e) { tx = e.target === vid ? null : e.changedTouches[0].clientX; }, { passive: true });   // a drag on the video's seek bar is not a swipe
      dlg.addEventListener('touchend', function (e) {
        if (tx == null) return;
        var d = e.changedTouches[0].clientX - tx;
        if (Math.abs(d) > 50) show(cur + (d < 0 ? 1 : -1));
      }, { passive: true });

      // Room links. Desktop: the page scrolls to the room heading (plain #anchor also works without JS).
      // Phone: the gallery is a horizontal carousel and the headings are hidden, so scroll the carousel to the room's first photo.
      var phone = matchMedia('(max-width: 899px)'), chips = document.getElementById('chips'), grid = document.getElementById('grid');
      function markChip(g) {
        if (!chips) return;
        chips.querySelectorAll('a').forEach(function (a) {
          var on = a.dataset.g === g;
          a.classList.toggle('on', on);
          if (on) chips.scrollTo({ left: a.offsetLeft - (chips.clientWidth - a.offsetWidth) / 2, behavior: 'smooth' });
        });
      }
      if (chips) {
        chips.addEventListener('click', function (e) {
          var a = e.target.closest('a'); if (!a || !phone.matches || a.hasAttribute('data-plan')) return;   // "Planta" is a plain jump
          e.preventDefault();
          var first = grid.querySelector('li[data-g="' + a.dataset.g + '"]');
          grid.scrollTo({ left: first.offsetLeft - grid.offsetLeft - 20, behavior: 'smooth' });
          markChip(a.dataset.g);
        });
        // active chip follows what is on screen (the page on desktop, the carousel on phones)
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (es) {
            es.forEach(function (en) { if (en.isIntersecting) markChip(en.target.dataset.g); });
          }, { threshold: 0.6, rootMargin: '-30% 0px -30% 0px' });
          grid.querySelectorAll('li[data-g]').forEach(function (li) { io.observe(li); });
        }
      }
      document.getElementById('theme').addEventListener('click', function () {
        var d = document.documentElement, dark = d.dataset.theme ? d.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        d.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', d.dataset.theme); } catch (e) {}
      });
    </script>
  </body>
</html>
