---
// One way out at the foot of the pages that have no Contact panel of their own (About, Case studies): the Contact stop, which has everything else.
interface Props { location: string }
const { location } = Astro.props;
---
<p class="links reach">
  <a href="/#contact" data-track="reach_contact" data-category="contact" data-location={location}>Get in touch ↓</a>
</p>
