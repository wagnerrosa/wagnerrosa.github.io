---
import { profiles, site } from '../../data/site';
interface Props { level?: 1 | 2; anchor?: boolean }
const { level = 1, anchor = false } = Astro.props;
const H = `h${level}` as 'h1' | 'h2';
const rows = [
  ...profiles.map(p => ({ label: p.label, href: p.href, mark: '↗', ext: true })),
  { label: 'CV (PDF)', href: site.cv.pdf, mark: '↓', ext: false },
  { label: 'ATS-friendly CV', href: site.cv.html, mark: '→', ext: false },
];
---
<section class="panel" data-id="contact" id={anchor ? 'contact' : undefined}>
  <div class="in">
    <H class="title big">Open to remote<br /><em>Product Design</em><br />opportunities.</H>
    <div class="p-body">
      <dl class="facts plain">
        <div><dt class="mono">Email</dt><dd><a href={`mailto:${site.email}`} data-track="contact_email" data-category="contact" data-location="panel">{site.email}</a></dd></div>
        <div><dt class="mono">Time zone</dt><dd>GMT-3 · Brazil, Europe and US overlap</dd></div>
      </dl>
      <ul class="rows compact">
        {rows.map((r, i) => (
          <li>
            <a href={r.href} {...(r.ext ? { target: '_blank', rel: 'noopener' } : {})} data-track={`contact_${r.label.toLowerCase().replace(/[^a-z]+/g, '_')}`} data-category={r.ext ? 'outbound' : 'navigation'} data-location="contact">
              <span class="mono">{String(i + 1).padStart(2, '0')}</span><span class="t">{r.label}</span><span class="mono m">{r.mark}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
