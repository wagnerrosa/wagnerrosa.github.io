---
// Trust: two real screens with pins, and beside them the documented misread, both readings at once (no control to operate).
// A div, not a figure: the wheel's photo motion moves figure images, and the pins must stay on their screens.
import { Image } from 'astro:assets';
import { asset } from '../../../lib/assets';
import Readout from '../../mdx/Readout.astro';
interface Pin { title: string; text: string }
interface Props { pins: Pin[]; shotA: { src: string; alt: string; x: number; y: number }; shotB: { src: string; alt: string; pins: { x: number; y: number }[] }; caption: string }
const { pins, shotA, shotB, caption } = Astro.props;
const sizes = '(max-width: 820px) 46vw, 230px';
---
<div class="plate soft ocr">
  <div class="ocr-stack">
    <div class="st st-a">
      <Image src={asset(shotA.src)} alt={shotA.alt} widths={[320, 480, 640]} sizes={sizes} loading="lazy" decoding="async" fetchpriority="low" />
      <span class="pin" style={`--x:${shotA.x}%;--y:${shotA.y}%`} aria-hidden="true">1</span>
    </div>
    <div class="st st-b">
      <Image src={asset(shotB.src)} alt={shotB.alt} widths={[320, 480, 640]} sizes={sizes} loading="lazy" decoding="async" fetchpriority="low" />
      {shotB.pins.map((p, i) => <span class="pin" style={`--x:${p.x}%;--y:${p.y}%`} aria-hidden="true">{i + 2}</span>)}
    </div>
  </div>
  <dl class="readings">
    <div><dt>On the dashboard</dt><dd><Readout value="27119" unit="km" label="27,119 kilometres" size="lg" /></dd></div>
    <div class="bad"><dt>What Vision returned in one test</dt><dd><Readout value="71190" unit="km" label="71,190 kilometres" size="lg" /></dd></div>
    <div class="rd-note"><dd>A jump of about 44,000 km. The field shows the distance from the last reading, so the error is visible before anything is saved.</dd></div>
  </dl>
</div>
<ol class="notes pins" style={`--n:${pins.length}`}>
  {pins.map((p, i) => <li><span class="nt-pin" aria-hidden="true">{i + 1}</span><b>{p.title}</b> {p.text}</li>)}
</ol>
<p class="plate-cap">{caption}</p>
