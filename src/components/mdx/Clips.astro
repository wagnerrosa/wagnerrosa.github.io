---
// Phone clips side by side. Poster only until scrolled into view (wheel.ts plays them while visible, never under reduced motion); controls always there.
interface Item { src: string; poster: string; label: string; caption: string }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<div class="clips wide">
  {items.map(it => (
    <figure>
      <video data-clip muted loop playsinline controls preload="none" poster={it.poster} aria-label={it.label}>
        <source src={it.src} type="video/mp4" />
      </video>
      <figcaption>{it.caption}</figcaption>
    </figure>
  ))}
</div>
