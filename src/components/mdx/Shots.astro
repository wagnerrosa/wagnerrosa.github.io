---
// A row of phone screens at the same scale: comparisons (v1 → v3), pairs of steps, themes. Real captures, no device frame.
import { Image } from 'astro:assets';
import { asset } from '../../lib/assets';
interface Item { src: string; alt: string; label: string; note?: string }
interface Props { items: Item[]; stagger?: boolean }
const { items, stagger = false } = Astro.props;
---
<figure class:list={['shots', 'wide', `n${items.length}`, { stagger }]}>
  {items.map(it => (
    <div class="shot">
      <Image src={asset(it.src)} alt={it.alt} widths={[320, 480, 640, 900]} sizes="(max-width: 820px) 48vw, 340px" loading="lazy" decoding="async" fetchpriority="low" />
      <p class="shot-l"><b>{it.label}</b>{it.note && <span>{it.note}</span>}</p>
    </div>
  ))}
  <figcaption><slot /></figcaption>
</figure>
