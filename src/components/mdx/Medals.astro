---
import { Image } from 'astro:assets';
import { asset } from '../../lib/assets';
interface Item { src: string; label: string }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<ul class="medals wide">
  {items.map(it => (
    <li><Image src={asset(it.src)} alt="" width={96} height={96} widths={[96, 192]} sizes="96px" loading="lazy" decoding="async" fetchpriority="low" /><span>{it.label}</span></li>
  ))}
</ul>
