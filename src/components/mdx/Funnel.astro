---
// Three readouts in a row on the dark stage: a funnel told in numbers. Items are plain strings, no invented data.
import Readout from './Readout.astro';
interface Item { value: string; label: string }
interface Props { items: Item[]; title: string }
const { items, title } = Astro.props;
---
<section class="funnel wide" aria-label={title}>
  <p class="sh-kicker"><i aria-hidden="true"></i>{title}</p>
  <ol>
    {items.map((it, i) => (
      <li style={`--i:${i}`}>
        <Readout value={it.value} label={`${it.value} ${it.label}`} size="lg" />
        <span class="fn-label">{it.label}</span>
      </li>
    ))}
  </ol>
  <div class="sh-cap"><slot /></div>
</section>
