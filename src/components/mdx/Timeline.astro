---
// Dated milestones with a visible status, so what is live is never confused with what is still being tested.
interface Item { date: string; title: string; text: string; status?: 'live' | 'testflight' }
interface Props { label?: string; items: Item[] }
const { label, items } = Astro.props;
const tag = { live: 'On the App Store', testflight: 'In TestFlight' };
---
<ol class="timeline" aria-label={label}>
  {items.map(it => (
    <li data-status={it.status}>
      <p class="tl-date">{it.date}</p>
      <div class="tl-body">
        <p class="tl-title">{it.title}{it.status && <span class="tl-tag">{tag[it.status]}</span>}</p>
        <p class="tl-text">{it.text}</p>
      </div>
    </li>
  ))}
</ol>
