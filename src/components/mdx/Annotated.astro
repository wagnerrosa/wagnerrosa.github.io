---
// One screen with numbered pins and the reasoning beside it. Pin positions are percentages of the image box.
import { Image } from 'astro:assets';
import { asset } from '../../lib/assets';
interface Pin { y: number; x?: number; title: string; text: string }
interface Props { src: string; alt: string; pins: Pin[] }
const { src, alt, pins } = Astro.props;
---
<figure class="ann wide">
  <div class="ann-img">
    <Image src={asset(src)} alt={alt} widths={[320, 480, 640, 900]} sizes="(max-width: 820px) 80vw, 320px" loading="lazy" decoding="async" fetchpriority="low" />
    {pins.map((p, i) => <span class="pin" style={`--x:${p.x ?? 96}%;--y:${p.y}%`} aria-hidden="true">{i + 1}</span>)}
  </div>
  <ol class="ann-list">{pins.map(p => <li><b>{p.title}</b> {p.text}</li>)}</ol>
  <figcaption><slot /></figcaption>
</figure>
