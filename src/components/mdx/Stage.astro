---
// Dark opening stage of an editorial case: one big readout + the product in motion (real clip, no device mockup).
import Readout from './Readout.astro';
interface Props { kicker: string; value: string; unit: string; label: string; clip: string; poster: string; clipLabel: string }
const { kicker, value, unit, label, clip, poster, clipLabel } = Astro.props;
---
<div class="stage-hero wide">
  <div class="sh-copy">
    <p class="sh-kicker"><i aria-hidden="true"></i>{kicker}</p>
    <Readout value={value} unit={unit} label={label} />
    <div class="sh-cap"><slot /></div>
  </div>
  <figure class="sh-phone">
    <video data-clip muted loop playsinline controls preload="none" poster={poster} aria-label={clipLabel}>
      <source src={clip} type="video/mp4" />
    </video>
  </figure>
</div>
