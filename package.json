{
  "name": "wagnerrosa-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "wagnerrosa.com: Astro static site (no framework JS in the browser), published to GitHub Pages.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "build:protected": "bash scripts/build-protected.sh",
    "seo:snapshot": "node scripts/seo-snapshot.mjs dist positioning/baseline/current.json",
    "seo:diff": "node scripts/seo-snapshot.mjs --diff positioning/baseline/legacy-final-2026-10-24.json positioning/baseline/current.json"
  },
  "author": "Wagner Rosa",
  "license": "ISC",
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/mdx": "^8.1.1",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "cheerio": "^1.2.0",
    "staticrypt": "^3.5.4"
  }
}
